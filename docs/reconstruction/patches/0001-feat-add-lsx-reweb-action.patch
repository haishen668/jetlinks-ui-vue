 const emptyValue = '--';
 
@@ -230,6 +244,13 @@ const lsxProfileItems = computed(() => {
 
 const lsxCards = computed(() => instanceStore.current?.cards || []);
 
+const hasRewebProfile = computed(() => hasValue((instanceStore.current as Record<string, any> | undefined)?.subDomain));
+
+const rewebUrl = computed(() => {
+    const subDomain = (instanceStore.current as Record<string, any> | undefined)?.subDomain;
+    return hasValue(subDomain) ? `http://${subDomain}.reweb.wugee.net.cn` : '';
+});
+
 const hasLsxProfile = computed(() => {
     const current = (instanceStore.current || {}) as Record<string, any>;
     const profileKeys = [
@@ -303,6 +324,37 @@ const giveAnInkling = () => {
     inkingVisible.value = true;
 };
 
+const openReweb = async () => {
+    const current = (instanceStore.current || {}) as Record<string, any>;
+    const deviceId = current.id;
+    const subDomain = current.subDomain;
+
+    if (!deviceId) {
+        onlyMessage('设备 ID 为空，无法打开 REWEB', 'warning');
+        return;
+    }
+
+    if (!hasValue(subDomain)) {
+        onlyMessage('设备缺少 REWEB 子域，无法打开远程 Web', 'warning');
+        return;
+    }
+
+    rewebLoading.value = true;
+    try {
+        await invokeInstanceFunction(deviceId, 'reweb', {
+            subDomain,
+            reweb: subDomain,
+            url: rewebUrl.value,
+        });
+        window.open(rewebUrl.value, '_blank');
+        onlyMessage('REWEB 指令已发送', 'success');
+    } catch (e) {
+        onlyMessage('REWEB 指令发送失败', 'error');
+    } finally {
+        rewebLoading.value = false;
+    }
+};
+
